<Window x:Class="YourLittleFriend.ShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YourLittleFriend"
        Title="YourLittleFriend" Icon="icon.ico" Width="980" Height="640" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI" FontSize="14" Topmost="True">
  <!-- a sinistra lo shop, a destra il carrello e il camerino. l'Overlay in fondo copre tutta la finestra e serve alle animazioni
       (carrello che passa, busta che vola, nuvoletta "puf"): non prende mai i clic -->
  <Grid>
    <Grid Margin="24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="350"/>
      </Grid.ColumnDefinitions>

      <!-- shop -->
      <Grid Margin="0,0,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ShopTitle" FontSize="22" FontWeight="Bold"/>
        <WrapPanel x:Name="Filters" Grid.Row="1" Margin="0,12,0,12"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <WrapPanel x:Name="Catalog" Margin="0,0,6,0"/>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- carrello -->
        <Border x:Name="CartBox" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="14" RenderTransformOrigin="0.5,0.5">
          <StackPanel>
            <TextBlock x:Name="CartTitle" FontSize="16" FontWeight="SemiBold"/>
            <WrapPanel x:Name="CartItems" MinHeight="56" Margin="0,8,0,6"/>
            <DockPanel>
              <Button x:Name="BBuy" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="0" Click="Buy_Click"/>
              <TextBlock x:Name="CartTotal" VerticalAlignment="Center" Opacity="0.75"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- camerino -->
        <Border x:Name="RoomBox" Grid.Row="1" Margin="0,14,0,0" Background="{DynamicResource BgSolidBrush}" CornerRadius="16" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="14,12,14,0">
              <Button x:Name="BTakeOff" DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0" Padding="10,3" FontSize="12" Click="TakeOff_Click"/>
              <TextBlock x:Name="RoomTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- il palco: la luce parte dal pavimento e sale, l'omino sta al centro -->
            <Grid x:Name="Stage" Grid.Row="1">
              <Path x:Name="Beam" Width="170" Height="190" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,14" Opacity="0.35" Data="M52,190 L118,190 L170,0 L0,0 Z">
                <Path.Fill>
                  <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#FFFFE9A8" Offset="0"/>
                    <GradientStop Color="#00FFE9A8" Offset="1"/>
                  </LinearGradientBrush>
                </Path.Fill>
              </Path>
              <Ellipse x:Name="Floor" Width="120" Height="22" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6" Fill="#44FFE9A8" Opacity="0.6"/>
              <local:Mascot x:Name="RoomMascot" Width="150" Height="150" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="12,0,12,12">
              <TextBlock x:Name="RoomHint" FontSize="12" Opacity="0.65" Margin="2,0,0,6" TextWrapping="Wrap"/>
              <ScrollViewer MaxHeight="124" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="OwnedPanel"/>
              </ScrollViewer>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True"/>
  </Grid>
</Window>
