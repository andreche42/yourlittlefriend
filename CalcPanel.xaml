<UserControl x:Class="YourLittleFriend.CalcPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- calcolatrice: scrivi l'espressione, il risultato si vede mentre scrivi; Invio la salva nella cronologia -->
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
      <Grid Height="34">
        <Rectangle Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource FgBrush}" StrokeThickness="2" StrokeDashArray="3 2" RadiusX="12" RadiusY="12"/>
        <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
                 FontSize="16" VerticalContentAlignment="Center" Margin="12,0" AllowDrop="False"/>
      </Grid>
      <TextBlock x:Name="Result" FontSize="25" FontWeight="Bold" TextAlignment="Right" Margin="0,3,6,0" TextTrimming="CharacterEllipsis" Height="34"/>
      <WrapPanel x:Name="Chips" Margin="0,2,0,0"/>
    </StackPanel>
    <DockPanel Grid.Column="1" Margin="14,0,0,0">
      <Button x:Name="BClear" DockPanel.Dock="Top" HorizontalAlignment="Right" Content="🗑" FontSize="12" Padding="6,1" Click="Clear_Click"/>
      <ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel x:Name="History"/></ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
