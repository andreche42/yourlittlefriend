<UserControl x:Class="YourLittleFriend.HolderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- holder: il "portabicchieri" per file e testo. le caselle si creano da sole in codice -->
  <Grid>
    <Rectangle x:Name="Frame" Stroke="White" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="16" RadiusY="16"/>
    <TextBlock x:Name="Empty" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
               TextAlignment="Center" TextWrapping="Wrap" Margin="16,0"/>
    <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                  Margin="8,0" VerticalAlignment="Center" PreviewMouseWheel="Wheel">
      <StackPanel x:Name="Items" Orientation="Horizontal"/>
    </ScrollViewer>
    <Button x:Name="ClearBtn" Content="🗑" FontSize="12" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,3,5,0" Click="Clear_Click"/>
  </Grid>
</UserControl>
