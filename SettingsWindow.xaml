<Window x:Class="YourLittleFriend.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YourLittleFriend"
        Title="yourlittlefriend" Width="500" Height="640" WindowStartupLocation="CenterScreen"
        Background="#111111" Foreground="White" FontFamily="Segoe UI" FontSize="14" Topmost="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,22">
        <TextBlock x:Name="HTitle" FontSize="24" FontWeight="Bold"/>

        <TextBlock x:Name="LName" Margin="0,18,0,4"/>
        <TextBox x:Name="NameIn" Style="{StaticResource Field}"/>

        <TextBlock x:Name="LCity" Margin="0,14,0,4"/>
        <TextBox x:Name="CityIn" Style="{StaticResource Field}"/>
        <TextBlock x:Name="CityStatus" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF9B9B"/>

        <TextBlock x:Name="LLang" Margin="0,14,0,6"/>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="RIt" Foreground="White" Content="Italiano" GroupName="lang" Margin="0,0,20,0"/>
          <RadioButton x:Name="REn" Foreground="White" Content="English" GroupName="lang"/>
        </StackPanel>

        <TextBlock x:Name="LModel" Margin="0,18,0,4"/>
        <TextBlock x:Name="ModelText" Foreground="#BBBBBB"/>
        <Button x:Name="BChange" Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Change_Click"/>
        <Border x:Name="AiBox" Visibility="Collapsed" Background="#1B1B1B" CornerRadius="12" Padding="16" Margin="0,10,0,0">
          <local:AiSetupPanel x:Name="Ai"/>
        </Border>

        <CheckBox x:Name="AutoStart" Foreground="White" Margin="0,22,0,0"/>

        <Button x:Name="BUninstall" Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,26,0,0" Background="#4A1F1F" Foreground="#FFB4B4" Click="Uninstall_Click"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,10,28,18">
      <Button x:Name="BCancel" Style="{StaticResource Pill}" Click="Cancel_Click"/>
      <Button x:Name="BSave" Style="{StaticResource Pill}" Background="#3A6BFF" Margin="0" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
