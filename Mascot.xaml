<UserControl x:Class="YourLittleFriend.Mascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- mascotte: corpo bianco, due occhi che sbattono, pallino e capsula. le animazioni stanno in Mascot.xaml.cs -->
  <Viewbox>
    <Canvas Width="100" Height="100" Background="Transparent">
      <Canvas x:Name="Body" Width="100" Height="100" RenderTransformOrigin="0.5,0.8">
        <Canvas.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="Sc"/>
            <RotateTransform x:Name="Rot"/>
            <TranslateTransform x:Name="Tr"/>
          </TransformGroup>
        </Canvas.RenderTransform>

        <Border Canvas.Left="22" Canvas.Top="28" Width="56" Height="42" CornerRadius="16" Background="{DynamicResource MascotBrush}"/>
        <Ellipse Canvas.Left="8" Canvas.Top="62" Width="10" Height="10" Fill="{DynamicResource MascotBrush}"/>
        <Border Canvas.Left="79" Canvas.Top="26" Width="14" Height="6" CornerRadius="3" Background="{DynamicResource MascotBrush}" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><RotateTransform Angle="-35"/></Border.RenderTransform>
        </Border>

        <!-- occhi normali (sbattono e guardano in giro) -->
        <Canvas x:Name="Eyes" Canvas.Left="0" Canvas.Top="40" Width="100" Height="18" RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="EyeSc"/>
              <TranslateTransform x:Name="EyeTr"/>
            </TransformGroup>
          </Canvas.RenderTransform>
          <Ellipse Canvas.Left="37.5" Canvas.Top="5" Width="5" Height="8" Fill="{DynamicResource MascotEyeBrush}"/>
          <Ellipse Canvas.Left="57.5" Canvas.Top="5" Width="5" Height="8" Fill="{DynamicResource MascotEyeBrush}"/>
        </Canvas>

        <!-- occhi felici ^ ^ e guance rosa -->
        <Canvas x:Name="HappyEyes" Width="100" Height="100" Visibility="Collapsed">
          <Path Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 36,52 Q 40,43 44,52"/>
          <Path Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 56,52 Q 60,43 64,52"/>
        </Canvas>
        <Canvas x:Name="Cheeks" Width="100" Height="100" Opacity="0">
          <Ellipse Canvas.Left="27" Canvas.Top="55" Width="9" Height="5" Fill="#FF9DB0"/>
          <Ellipse Canvas.Left="64" Canvas.Top="55" Width="9" Height="5" Fill="#FF9DB0"/>
        </Canvas>

        <!-- meteo: palpebre ("boh", sonno), occhi spaventati, bocca -->
        <Canvas x:Name="Lids" Canvas.Left="0" Canvas.Top="43" Width="100" Height="11" RenderTransformOrigin="0.5,0" Visibility="Collapsed">
          <Canvas.RenderTransform><ScaleTransform x:Name="LidSc" ScaleY="0.5"/></Canvas.RenderTransform>
          <Rectangle Canvas.Left="34" Width="12" Height="11" Fill="{DynamicResource MascotBrush}"/>
          <Rectangle Canvas.Left="54" Width="12" Height="11" Fill="{DynamicResource MascotBrush}"/>
        </Canvas>
        <Canvas x:Name="ScaredEyes" Width="100" Height="100" Visibility="Collapsed">
          <Ellipse Canvas.Left="33" Canvas.Top="42" Width="14" Height="14" Fill="White" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.6"/>
          <Ellipse Canvas.Left="53" Canvas.Top="42" Width="14" Height="14" Fill="White" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.6"/>
          <Ellipse Canvas.Left="38.3" Canvas.Top="47.3" Width="3.4" Height="3.4" Fill="{DynamicResource MascotEyeBrush}"/>
          <Ellipse Canvas.Left="58.3" Canvas.Top="47.3" Width="3.4" Height="3.4" Fill="{DynamicResource MascotEyeBrush}"/>
        </Canvas>
        <Path x:Name="Mouth" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>

        <!-- meteo: occhiali da sole, sciarpa, goccia di sudore, zzz -->
        <Canvas x:Name="Shades" Width="100" Height="100" Visibility="Collapsed">
          <Canvas.RenderTransform><TranslateTransform x:Name="ShadesTr"/></Canvas.RenderTransform>
          <Rectangle Canvas.Left="25" Canvas.Top="45" Width="8" Height="2" Fill="#14161B"/>
          <Rectangle Canvas.Left="67" Canvas.Top="45" Width="8" Height="2" Fill="#14161B"/>
          <Rectangle Canvas.Left="47" Canvas.Top="45.5" Width="6" Height="2.4" Fill="#14161B"/>
          <Border Canvas.Left="31" Canvas.Top="43" Width="18" Height="12" CornerRadius="3,3,7,7" Background="#14161B" BorderBrush="#66FFFFFF" BorderThickness="0.8"/>
          <Border Canvas.Left="51" Canvas.Top="43" Width="18" Height="12" CornerRadius="3,3,7,7" Background="#14161B" BorderBrush="#66FFFFFF" BorderThickness="0.8"/>
          <Rectangle Canvas.Left="34" Canvas.Top="45" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="White" Opacity="0.35"/>
          <Rectangle Canvas.Left="54" Canvas.Top="45" Width="6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="White" Opacity="0.35"/>
        </Canvas>
        <Canvas x:Name="Scarf" Width="100" Height="100" Visibility="Collapsed">
          <Border Canvas.Left="62" Canvas.Top="63" Width="9" Height="21" CornerRadius="4" Background="#C93B40" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform><RotateTransform Angle="6"/></Border.RenderTransform>
          </Border>
          <Border Canvas.Left="21" Canvas.Top="59" Width="58" Height="9" CornerRadius="4.5" Background="#E5484D"/>
          <Rectangle Canvas.Left="32" Canvas.Top="59" Width="4" Height="9" Fill="#F5A3A6" Opacity="0.7"/>
          <Rectangle Canvas.Left="50" Canvas.Top="59" Width="4" Height="9" Fill="#F5A3A6" Opacity="0.7"/>
        </Canvas>
        <Path x:Name="Sweat" Visibility="Collapsed" Fill="#7FD3FF" Canvas.Left="72" Canvas.Top="36" Data="M0,0 C-3,5 -4,8 0,10 C4,8 3,5 0,0 Z">
          <Path.RenderTransform><TranslateTransform x:Name="SweatTr"/></Path.RenderTransform>
        </Path>
        <Canvas x:Name="Zzz" Width="100" Height="100" Visibility="Collapsed">
          <TextBlock x:Name="Z1" Canvas.Left="68" Canvas.Top="22" Text="z" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Opacity="0"/>
          <TextBlock x:Name="Z2" Canvas.Left="76" Canvas.Top="10" Text="Z" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Opacity="0"/>
        </Canvas>

        <!-- pollice in su (calcolatrice: 104, 67, 69, 420) -->
        <Canvas x:Name="Thumb" Width="100" Height="100" Visibility="Collapsed" RenderTransformOrigin="0.85,0.7">
          <Canvas.RenderTransform><ScaleTransform x:Name="ThumbSc" ScaleX="0" ScaleY="0"/></Canvas.RenderTransform>
          <Border Canvas.Left="83" Canvas.Top="37" Width="7.5" Height="16" CornerRadius="3.75" Background="{DynamicResource MascotBrush}" BorderBrush="{DynamicResource MascotEyeBrush}" BorderThickness="1.2"/>
          <Border Canvas.Left="78" Canvas.Top="49" Width="17" Height="15" CornerRadius="5" Background="{DynamicResource MascotBrush}" BorderBrush="{DynamicResource MascotEyeBrush}" BorderThickness="1.2"/>
          <Rectangle Canvas.Left="80.5" Canvas.Top="53.5" Width="12" Height="1" Fill="{DynamicResource MascotEyeBrush}" Opacity="0.45"/>
          <Rectangle Canvas.Left="80.5" Canvas.Top="57.5" Width="12" Height="1" Fill="{DynamicResource MascotEyeBrush}" Opacity="0.45"/>
        </Canvas>

        <!-- meteo: ombrello (sopra la testa) e gocce che cadono ai lati -->
        <Canvas x:Name="RainDrops" Width="100" Height="100" Visibility="Collapsed">
          <Rectangle x:Name="R1" Canvas.Left="9" Canvas.Top="20" Width="1.8" Height="6" RadiusX="0.9" RadiusY="0.9" Fill="#7FB8FF" Opacity="0"/>
          <Rectangle x:Name="R2" Canvas.Left="20" Canvas.Top="20" Width="1.8" Height="6" RadiusX="0.9" RadiusY="0.9" Fill="#7FB8FF" Opacity="0"/>
          <Rectangle x:Name="R3" Canvas.Left="79" Canvas.Top="20" Width="1.8" Height="6" RadiusX="0.9" RadiusY="0.9" Fill="#7FB8FF" Opacity="0"/>
          <Rectangle x:Name="R4" Canvas.Left="90" Canvas.Top="20" Width="1.8" Height="6" RadiusX="0.9" RadiusY="0.9" Fill="#7FB8FF" Opacity="0"/>
        </Canvas>
        <Canvas x:Name="Umbrella" Width="100" Height="100" RenderTransformOrigin="0.5,0.3" Visibility="Collapsed">
          <Canvas.RenderTransform><RotateTransform x:Name="UmbRot"/></Canvas.RenderTransform>
          <Path Stroke="{DynamicResource FgBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M50,20 L50,32"/>
          <Path Fill="{DynamicResource AccentBrush}" Data="M16,22 A34,17 0 0 1 84,22 Q75,17.5 67,22 Q58.5,17.5 50,22 Q41.5,17.5 33,22 Q24.5,17.5 16,22 Z"/>
          <Ellipse Canvas.Left="48.8" Canvas.Top="3" Width="2.4" Height="3.5" Fill="{DynamicResource FgBrush}"/>
        </Canvas>

        <!-- puntini "sto pensando" sopra la testa -->
        <Canvas x:Name="Dots" Width="100" Height="100" Visibility="Collapsed">
          <Ellipse x:Name="D1" Canvas.Left="38" Canvas.Top="14" Width="6" Height="6" Fill="{DynamicResource FgBrush}" Opacity="0"/>
          <Ellipse x:Name="D2" Canvas.Left="47" Canvas.Top="14" Width="6" Height="6" Fill="{DynamicResource FgBrush}" Opacity="0"/>
          <Ellipse x:Name="D3" Canvas.Left="56" Canvas.Top="14" Width="6" Height="6" Fill="{DynamicResource FgBrush}" Opacity="0"/>
        </Canvas>
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
