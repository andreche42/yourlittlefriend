<UserControl x:Class="YourLittleFriend.Mascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- mascotte: corpo bianco, due occhi che sbattono, pallino e capsula. le animazioni stanno in Mascot.xaml.cs -->
  <Viewbox>
    <Canvas Width="100" Height="100">
      <Canvas x:Name="Body" Width="100" Height="100" RenderTransformOrigin="0.5,0.8">
        <Canvas.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="Sc"/>
            <RotateTransform x:Name="Rot"/>
            <TranslateTransform x:Name="Tr"/>
          </TransformGroup>
        </Canvas.RenderTransform>

        <Border Canvas.Left="22" Canvas.Top="28" Width="56" Height="42" CornerRadius="16" Background="#F4F4F4"/>
        <Ellipse Canvas.Left="8" Canvas.Top="62" Width="10" Height="10" Fill="#F4F4F4"/>
        <Border Canvas.Left="79" Canvas.Top="26" Width="14" Height="6" CornerRadius="3" Background="#F4F4F4" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><RotateTransform Angle="-35"/></Border.RenderTransform>
        </Border>

        <!-- occhi normali (sbattono e guardano in giro) -->
        <Canvas x:Name="Eyes" Canvas.Left="0" Canvas.Top="40" Width="100" Height="18" RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="EyeSc"/>
              <TranslateTransform x:Name="EyeTr"/>
            </TransformGroup>
          </Canvas.RenderTransform>
          <Ellipse Canvas.Left="37.5" Canvas.Top="5" Width="5" Height="8" Fill="#222222"/>
          <Ellipse Canvas.Left="57.5" Canvas.Top="5" Width="5" Height="8" Fill="#222222"/>
        </Canvas>

        <!-- occhi felici ^ ^ e guance rosa -->
        <Canvas x:Name="HappyEyes" Width="100" Height="100" Visibility="Collapsed">
          <Path Stroke="#222222" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 36,52 Q 40,43 44,52"/>
          <Path Stroke="#222222" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 56,52 Q 60,43 64,52"/>
        </Canvas>
        <Canvas x:Name="Cheeks" Width="100" Height="100" Opacity="0">
          <Ellipse Canvas.Left="27" Canvas.Top="55" Width="9" Height="5" Fill="#FF9DB0"/>
          <Ellipse Canvas.Left="64" Canvas.Top="55" Width="9" Height="5" Fill="#FF9DB0"/>
        </Canvas>

        <!-- puntini "sto pensando" sopra la testa -->
        <Canvas x:Name="Dots" Width="100" Height="100" Visibility="Collapsed">
          <Ellipse x:Name="D1" Canvas.Left="38" Canvas.Top="14" Width="6" Height="6" Fill="#F4F4F4" Opacity="0"/>
          <Ellipse x:Name="D2" Canvas.Left="47" Canvas.Top="14" Width="6" Height="6" Fill="#F4F4F4" Opacity="0"/>
          <Ellipse x:Name="D3" Canvas.Left="56" Canvas.Top="14" Width="6" Height="6" Fill="#F4F4F4" Opacity="0"/>
        </Canvas>
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
