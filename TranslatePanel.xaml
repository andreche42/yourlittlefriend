<UserControl x:Class="YourLittleFriend.TranslatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YourLittleFriend">
  <!-- traduttore: scegli le lingue, scrivi a sinistra, Invio traduce; la traduzione compare a destra -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel>
      <Button x:Name="BCopy" DockPanel.Dock="Right" Content="📋" FontSize="13" Padding="8,2" Click="Copy_Click"/>
      <Button x:Name="BGo" DockPanel.Dock="Right" Style="{StaticResource Primary}" FontSize="13" Padding="14,3" Margin="0,0,6,0" Click="Go_Click"/>
      <TextBlock x:Name="Info" DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource FgDimBrush}"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BFrom" FontSize="13" Padding="10,2" Click="From_Click"/>
        <Button x:Name="BSwap" Content="⇄" FontSize="14" Padding="8,2" Click="Swap_Click"/>
        <Button x:Name="BTo" FontSize="13" Padding="10,2" Click="To_Click"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,6,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,5,0">
        <Rectangle Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource FgBrush}" StrokeThickness="2" StrokeDashArray="3 2" RadiusX="12" RadiusY="12"/>
        <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
                 FontSize="14" Margin="10,6" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" AllowDrop="False"/>
      </Grid>
      <Border Grid.Column="1" Margin="5,0,0,0" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="10,6">
        <ScrollViewer VerticalScrollBarVisibility="Hidden"><local:SmokeText x:Name="Output" TextElement.FontSize="14"/></ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
