<Window x:Class="YourLittleFriend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="yourlittlefriend" Width="230" Height="34" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
  <Window.Resources>
    <ContextMenu x:Key="Menu">
      <MenuItem Header="esci" Click="Quit_Click"/>
    </ContextMenu>

    <!-- mascotte: corpo bianco, due occhi che sbattono, pallino e capsula -->
    <DataTemplate x:Key="MascotT">
      <Viewbox>
        <Canvas Width="100" Height="100">
          <Canvas.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Eyes"
                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" Duration="0:0:3.3">
                    <LinearDoubleKeyFrame KeyTime="0:0:3.0" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:3.08" Value="0.1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="1"/>
                  </DoubleAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Canvas.Triggers>
          <Border Canvas.Left="22" Canvas.Top="28" Width="56" Height="42" CornerRadius="16" Background="#F4F4F4"/>
          <Ellipse Canvas.Left="8" Canvas.Top="62" Width="10" Height="10" Fill="#F4F4F4"/>
          <Border Canvas.Left="79" Canvas.Top="26" Width="14" Height="6" CornerRadius="3" Background="#F4F4F4" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><RotateTransform Angle="-35"/></Border.RenderTransform>
          </Border>
          <Canvas x:Name="Eyes" Canvas.Left="0" Canvas.Top="40" Width="100" Height="18" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform><ScaleTransform ScaleY="1"/></Canvas.RenderTransform>
            <Ellipse Canvas.Left="37.5" Canvas.Top="5" Width="5" Height="8" Fill="#222222"/>
            <Ellipse Canvas.Left="57.5" Canvas.Top="5" Width="5" Height="8" Fill="#222222"/>
          </Canvas>
        </Canvas>
      </Viewbox>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" Background="Black" CornerRadius="0,0,22,22" ContextMenu="{StaticResource Menu}"
          TextElement.Foreground="White" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14"
          MouseEnter="OnEnter" MouseLeave="OnLeave">
    <Grid>
      <ContentControl x:Name="MiniMascot" ContentTemplate="{StaticResource MascotT}" Content="x"
                      Width="28" Height="28" VerticalAlignment="Top" Margin="0,3,0,0"/>

      <Grid x:Name="Full" Visibility="Collapsed" Margin="14,6,14,10">
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <DockPanel>
          <Button DockPanel.Dock="Right" Content="⚙" Click="Gear_Click"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="T0" Content="⌂" Tag="0" Click="Tab_Click"/>
            <Button x:Name="T1" Content="💬" Tag="1" Click="Tab_Click"/>
            <Button x:Name="T2" Content="+" Tag="2" Click="Tab_Click"/>
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ContentControl ContentTemplate="{StaticResource MascotT}" Content="x" Width="84" Height="84" VerticalAlignment="Center"/>

          <Grid Grid.Column="1">
            <!-- scheda home: saluto + meteo, oppure musica -->
            <Grid x:Name="PageHome">
              <Grid x:Name="Greet" Margin="10,0,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock Text="Ciao Andrea!" FontSize="26" FontWeight="Bold"/>
                  <TextBlock Text="Come va?"/>
                </StackPanel>
                <TextBlock x:Name="WeatherText" Text="…" FontSize="16" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextAlignment="Right"/>
              </Grid>
              <Border x:Name="MusicPanel" CornerRadius="16" Padding="10,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Image x:Name="CoverImg" Width="64" Height="64" Stretch="UniformToFill"/>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Ascoltando ora:" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="SongText" FontSize="16" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BPrev" Content="⏮" Tag="prev" Click="Ctl"/>
                    <Button x:Name="BPlay" Content="⏯" Tag="play" Click="Ctl"/>
                    <Button x:Name="BNext" Content="⏭" Tag="next" Click="Ctl"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- scheda chat -->
            <Grid x:Name="PageChat" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="ChatOut" Text="Chiedimi qualcosa" TextWrapping="Wrap" Margin="4,0,0,6"/>
              <Grid Grid.Row="1" Height="36">
                <Rectangle Fill="#555555" Stroke="White" StrokeThickness="2" StrokeDashArray="3 2" RadiusX="12" RadiusY="12"/>
                <TextBox x:Name="ChatIn" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                         FontSize="16" VerticalContentAlignment="Center" Margin="12,0" AllowDrop="False" KeyDown="ChatKey"/>
                <TextBlock Text="scrivi qua" Foreground="#BBBBBB" FontSize="16" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=ChatIn}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Grid>

            <!-- scheda + : trascina un file -->
            <Grid x:Name="PageFile" Visibility="Collapsed">
              <Grid x:Name="DropZone">
                <Rectangle Stroke="White" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="16" RadiusY="16"/>
                <TextBlock Text="Trascina o rilascia un file" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <Grid x:Name="FileView" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="📄" FontSize="50" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="FileNameText" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="86"/>
                </StackPanel>
                <Grid Grid.Column="1">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Background="White" CornerRadius="12" Padding="10,5" Margin="0,0,0,6" VerticalAlignment="Top">
                    <TextBlock x:Name="Bubble" Text="Cosa faccio con questo?" Foreground="Black" FontSize="12" TextWrapping="Wrap"/>
                  </Border>
                  <Grid Grid.Row="1" Height="36">
                    <Rectangle Fill="#555555" Stroke="White" StrokeThickness="2" StrokeDashArray="3 2" RadiusX="12" RadiusY="12"/>
                    <TextBox x:Name="FileIn" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                             FontSize="16" VerticalContentAlignment="Center" Margin="12,0" AllowDrop="False" KeyDown="FileKey"/>
                    <TextBlock Text="scrivi qua" Foreground="#BBBBBB" FontSize="16" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FileIn}" Value="">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
