<Window x:Class="YourLittleFriend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YourLittleFriend"
        Title="yourlittlefriend" Width="980" Height="620" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
  <Window.Resources>
    <ContextMenu x:Key="Menu">
      <MenuItem Header="{local:L It=Impostazioni, En=Settings}" Click="Settings_Click"/>
      <MenuItem Header="{local:L It='Riporta in posizione', En='Reset position'}" Click="ResetPos_Click"/>
      <MenuItem Header="{local:L It=Esci, En=Quit}" Click="Quit_Click"/>
    </ContextMenu>
  </Window.Resources>

  <!-- la finestra è trasparente e fissa (non si ridimensiona mai): si muovono solo Root (il notch o la bolla), le tre scie G1..G3
       e l'onda Ripple. le posizioni le calcola il codice (margini), perché la bolla si può spostare -->
  <Grid>
    <Border x:Name="Ripple" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" BorderThickness="2.5" BorderBrush="{DynamicResource AccentBrush}"
            HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform x:Name="RippleSc"/></Border.RenderTransform>
    </Border>
    <Border x:Name="G3" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource BgSolidBrush}" CornerRadius="0,0,22,22" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    <Border x:Name="G2" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource BgSolidBrush}" CornerRadius="0,0,22,22" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    <Border x:Name="G1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource BgSolidBrush}" CornerRadius="0,0,22,22" HorizontalAlignment="Left" VerticalAlignment="Top"/>
  <Border x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource OutlineThickness}" CornerRadius="0,0,22,22" ContextMenu="{StaticResource Menu}"
          TextElement.Foreground="{DynamicResource FgBrush}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14" ToolTipService.InitialShowDelay="250"
          MouseEnter="OnEnter" MouseLeave="OnLeave" MouseLeftButtonDown="Root_Down" MouseMove="Root_Move" MouseLeftButtonUp="Root_Up" LostMouseCapture="Root_Lost" MouseWheel="Root_Wheel">
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="JellySc"/>
        <TranslateTransform x:Name="BobTr"/>
      </TransformGroup>
    </Border.RenderTransform>
    <Grid>
      <!-- riflesso della bolla -->
      <Border x:Name="Shine" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><RotateTransform Angle="-28"/></Border.RenderTransform>
      </Border>
      <local:Mascot x:Name="MiniMascot" WanderRange="80" Width="28" Height="28" VerticalAlignment="Top" Margin="0,3,0,0"/>

      <Grid x:Name="Full" Visibility="Collapsed" Opacity="0" Width="612" Height="154" Margin="0,6,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="FullScale"/>
            <TranslateTransform x:Name="FullShift"/>
          </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <DockPanel>
          <Button DockPanel.Dock="Right" Content="⚙" Click="Gear_Click" ToolTip="{local:L It=Impostazioni, En=Settings}"/>
          <Button x:Name="BExpand" DockPanel.Dock="Right" Click="Expand_Click" ToolTip="{local:L It='Espandi / riduci', En='Expand / shrink'}">
            <Viewbox Width="16" Height="16" Margin="0,3">
              <Canvas Width="16" Height="16">
                <Path x:Name="ExpandIcon" Stroke="{DynamicResource FgBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10"/>
              </Canvas>
            </Viewbox>
          </Button>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="T0" Content="⌂" Tag="0" Click="Tab_Click" ToolTip="{local:L It=Home, En=Home}"/>
            <Button x:Name="T1" Content="💬" Tag="1" Click="Tab_Click" ToolTip="{local:L It=Chat, En=Chat}"/>
            <Button x:Name="T4" Tag="4" Click="Tab_Click" ToolTip="{local:L It=Calcolatrice, En=Calculator}">
              <Viewbox Width="17" Height="17" Margin="0,2">
                <Canvas Width="16" Height="16">
                  <Path Stroke="{DynamicResource FgBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M4,1.5 H12 A1.5,1.5 0 0 1 13.5,3 V13 A1.5,1.5 0 0 1 12,14.5 H4 A1.5,1.5 0 0 1 2.5,13 V3 A1.5,1.5 0 0 1 4,1.5 Z M5,5 H11 M5.2,8.5 H5.3 M8,8.5 H8.1 M10.8,8.5 H10.9 M5.2,11.5 H5.3 M8,11.5 H8.1 M10.8,11.5 H10.9"/>
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="T5" Content="文A" FontSize="13" Padding="8,4" Tag="5" Click="Tab_Click" ToolTip="{local:L It=Traduttore, En=Translator}"/>
            <Button x:Name="T6" Content="W" FontFamily="Georgia" FontWeight="Bold" FontSize="15" Padding="9,2" Tag="6" Click="Tab_Click" ToolTip="Wikipedia"/>
            <Button x:Name="T3" Tag="3" Click="Tab_Click" ToolTip="{local:L It=Portafile, En='File holder'}">
              <Viewbox Width="17" Height="17" Margin="0,2">
                <Canvas Width="16" Height="16">
                  <Path Stroke="{DynamicResource FgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M2,9.5 L2,13 L14,13 L14,9.5 M8,2 L8,9.5 M4.8,6.6 L8,9.8 L11.2,6.6"/>
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="T2" Content="+" Tag="2" Click="Tab_Click" ToolTip="{local:L It='Chiedi su un file', En='Ask about a file'}"/>
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <local:Mascot x:Name="BigMascot" Width="84" Height="84" VerticalAlignment="Top" Margin="0,16,0,0"/>

          <Grid Grid.Column="1">
            <!-- scheda home: saluto + meteo, oppure musica -->
            <Grid x:Name="PageHome">
              <Grid x:Name="Greet" Margin="10,0,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock x:Name="GreetTitle" FontSize="26" FontWeight="Bold"/>
                  <TextBlock Text="{local:L It='Come va?', En='How are you?'}"/>
                </StackPanel>
                <!-- meteo: icona animata, temperatura, descrizione e minima/massima -->
                <StackPanel x:Name="WeatherBox" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                  <local:WeatherIcon x:Name="WIcon" Width="58" Height="58"/>
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="WTemp" FontSize="36" FontWeight="Bold" Margin="0,-6,0,-6"/>
                    <TextBlock x:Name="WDesc" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WDetail" FontSize="11" Foreground="{DynamicResource FgDimBrush}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Border x:Name="MusicPanel" CornerRadius="16" Padding="10,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Image x:Name="CoverImg" Width="64" Height="64" Stretch="UniformToFill"/>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:L It='Ascoltando ora:', En='Now playing:'}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SongText" FontSize="16" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BPrev" Content="⏮" Tag="prev" Click="Ctl" ToolTip="{local:L It=Precedente, En=Previous}"/>
                    <Button x:Name="BPlay" Content="⏯" Tag="play" Click="Ctl" ToolTip="{local:L It='Play / Pausa', En='Play / Pause'}"/>
                    <Button x:Name="BNext" Content="⏭" Tag="next" Click="Ctl" ToolTip="{local:L It=Successivo, En=Next}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- scheda chat -->
            <Grid x:Name="PageChat" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="4,0,0,6">
                <local:SmokeText x:Name="ChatOut"/>
              </ScrollViewer>
              <Grid Grid.Row="1" Height="36">
                <Rectangle Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource FgBrush}" StrokeThickness="2" StrokeDashArray="3 2" RadiusX="12" RadiusY="12"/>
                <TextBox x:Name="ChatIn" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
                         FontSize="16" VerticalContentAlignment="Center" Margin="12,0" AllowDrop="False" KeyDown="ChatKey"/>
                <TextBlock Text="{local:L It='scrivi qua', En='type here'}" Foreground="{DynamicResource FgDimBrush}" FontSize="16" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=ChatIn}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Grid>

            <!-- schede calcolatrice, traduttore e wikipedia -->
            <Grid x:Name="PageCalc" Visibility="Collapsed"><local:CalcPanel x:Name="CalcBox"/></Grid>
            <Grid x:Name="PageTranslate" Visibility="Collapsed"><local:TranslatePanel x:Name="TranslateBox"/></Grid>
            <Grid x:Name="PageWiki" Visibility="Collapsed"><local:WikiPanel x:Name="WikiBox"/></Grid>

            <!-- scheda holder: file e testo che si trascinano dentro e fuori -->
            <Grid x:Name="PageHolder" Visibility="Collapsed">
              <local:HolderPanel x:Name="Holder"/>
            </Grid>

            <!-- scheda + : trascina un file -->
            <Grid x:Name="PageFile" Visibility="Collapsed">
              <Grid x:Name="DropZone">
                <Rectangle Stroke="{DynamicResource FgBrush}" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="16" RadiusY="16"/>
                <TextBlock Text="{local:L It='Trascina o rilascia un file', En='Drag or drop a file'}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <Grid x:Name="FileView" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="📄" FontSize="50" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="FileNameText" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="86"/>
                </StackPanel>
                <Grid Grid.Column="1">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Background="{DynamicResource FgBrush}" CornerRadius="12" Padding="10,5" Margin="0,0,0,6" VerticalAlignment="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                      <local:SmokeText x:Name="Bubble" TextElement.Foreground="{DynamicResource BgSolidBrush}" TextElement.FontSize="12"/>
                    </ScrollViewer>
                  </Border>
                  <Grid Grid.Row="1" Height="36">
                    <Rectangle Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource FgBrush}" StrokeThickness="2" StrokeDashArray="3 2" RadiusX="12" RadiusY="12"/>
                    <TextBox x:Name="FileIn" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
                             FontSize="16" VerticalContentAlignment="Center" Margin="12,0" AllowDrop="False" KeyDown="FileKey"/>
                    <TextBlock Text="{local:L It='scrivi qua', En='type here'}" Foreground="{DynamicResource FgDimBrush}" FontSize="16" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FileIn}" Value="">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <!-- maniglia: trascinala per ridimensionare il pannello espanso -->
      <Border x:Name="Grip" Visibility="Collapsed" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
              Background="Transparent" Cursor="SizeNWSE" ToolTip="{local:L It='Trascina per ridimensionare', En='Drag to resize'}"
              MouseLeftButtonDown="Grip_Down" MouseMove="Grip_Move" MouseLeftButtonUp="Grip_Up">
        <Path Stroke="{DynamicResource FgDimBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M17,6 L6,17 M17,11 L11,17"/>
      </Border>
    </Grid>
  </Border>
  </Grid>
</Window>
