<UserControl x:Class="YourLittleFriend.MicButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- microfonino: si mette accanto a una casella di scrittura. si preme per dettare, si ripreme per fermare -->
  <Button x:Name="B" Padding="0" Background="Transparent">
    <Viewbox Width="15" Height="15">
      <Canvas Width="16" Height="16">
        <Path x:Name="Icon" Stroke="{DynamicResource FgBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M8,2.3 A2.1,2.1 0 0 1 10.1,4.4 V8 A2.1,2.1 0 0 1 5.9,8 V4.4 A2.1,2.1 0 0 1 8,2.3 Z M3.9,7.6 A4.1,4.1 0 0 0 12.1,7.6 M8,11.7 V14 M5.7,14 H10.3"/>
      </Canvas>
    </Viewbox>
  </Button>
</UserControl>
