<UserControl x:Class="YourLittleFriend.WikiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- wikipedia: scrivi una cosa, esce titolo, descrizione, riassunto e foto; scorri in basso per leggere tutto l'articolo -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Rectangle Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource FgBrush}" StrokeThickness="2" StrokeDashArray="3 2" RadiusX="12" RadiusY="12"/>
      <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
               FontSize="16" VerticalContentAlignment="Center" Margin="12,0,12,0" AllowDrop="False"/>
      <TextBlock x:Name="Hint" Foreground="{DynamicResource FgDimBrush}" FontSize="15" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <ScrollViewer x:Name="Scroll" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource FgDimBrush}" Margin="4,2,0,0"/>
        <StackPanel x:Name="Article" Visibility="Collapsed" Margin="0,0,10,6">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="PhotoBox" Width="86" Height="86" CornerRadius="12" ClipToBounds="True" Margin="0,2,12,0" VerticalAlignment="Top" Visibility="Collapsed">
              <Image x:Name="Photo" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="Title" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
              <TextBlock x:Name="Desc" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource FgDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
              <TextBlock x:Name="Summary" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <WrapPanel x:Name="Gallery" Margin="0,12,0,0"/>
          <TextBlock x:Name="Rest" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource FgDimBrush}" Margin="0,10,0,0"/>
          <Button x:Name="BOpen" HorizontalAlignment="Left" Style="{StaticResource Pill}" FontSize="12" Padding="10,3" Margin="0,10,0,0" Click="Open_Click"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
