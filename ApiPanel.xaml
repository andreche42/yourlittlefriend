<UserControl x:Class="YourLittleFriend.ApiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- porta la tua llm: qualunque servizio con la chiave dell'utente, tutti parlano la lingua di openai -->
  <UserControl.Resources>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <TextBlock x:Name="LProvider" Margin="0,0,0,4"/>
    <ComboBox x:Name="ProviderCb" Height="30" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource FgBrush}"
              BorderBrush="{DynamicResource FgDimBrush}" SelectionChanged="Provider_Changed"/>
    <TextBlock x:Name="LKey" Margin="0,10,0,4"/>
    <PasswordBox x:Name="KeyIn" Height="32" Padding="8,6" Background="{DynamicResource PanelBrush}"
                 Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource FgDimBrush}"/>
    <TextBlock x:Name="LBase" Margin="0,10,0,4"/>
    <TextBox x:Name="BaseIn" Style="{StaticResource Field}"/>
    <TextBlock x:Name="LModel" Margin="0,10,0,4"/>
    <ComboBox x:Name="ModelCb" IsEditable="True" Height="30" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource FgBrush}"
              BorderBrush="{DynamicResource FgDimBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button x:Name="BLoad" Style="{StaticResource Pill}" Click="Load_Click"/>
      <Button x:Name="BTest" Style="{StaticResource Pill}" Click="Test_Click"/>
      <Button x:Name="BKey" Style="{StaticResource Pill}" Click="Key_Click"/>
    </StackPanel>
    <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource FgDimBrush}"/>
  </StackPanel>
</UserControl>
