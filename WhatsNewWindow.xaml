<Window x:Class="YourLittleFriend.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YourLittleFriend"
        Title="YourLittleFriend" Icon="icon.ico" Width="560" Height="580" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI" FontSize="14" Topmost="True">
  <Grid Margin="28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Background="{DynamicResource BgSolidBrush}" CornerRadius="16" Width="56" Height="56">
        <local:Mascot Width="46" Height="46"/>
      </Border>
      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="Sub" FontSize="13" Foreground="{DynamicResource FgBrush}" Opacity="0.7" Margin="0,3,0,0"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Notes" Margin="0,0,14,0"/>
    </ScrollViewer>

    <Button x:Name="BOk" Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource Primary}" Click="Ok_Click"/>
  </Grid>
</Window>
